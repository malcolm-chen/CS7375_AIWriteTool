# Copy to backend/.env and fill in. Restart the backend after editing.

# Providers tried in order; the next one is used if a call fails.
LLM_PROVIDERS=openai,kimi

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=none

KIMI_API_KEY=
KIMI_MODEL=kimi-k3
# Moonshot global; use https://api.moonshot.cn/v1 for China-mainland keys.
KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_REASONING_EFFORT=low

# Optional per provider: <NAME>_TEMPERATURE, <NAME>_TIMEOUT (seconds, default 180)

COWRITE_ADMIN_PASSWORD=admin
COWRITE_SECRET=dev-secret-change-me

# On the deployed server: admin cookie over HTTPS only, and the server won't start with the defaults
# above (password >= 12 chars, secret >= 32 chars) or with demo mode on. See deploy/README.md.
COWRITE_PRODUCTION=0
# A participant who started this long ago without finishing no longer counts toward balance.
# COWRITE_ABANDON_HOURS=24

# /demo creates a fresh participant session without login. Turn off for the real study.
COWRITE_DEMO=0
